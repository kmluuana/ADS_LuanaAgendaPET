generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum StatusAgendamento {
  AGENDADO
  CONCLUIDO
  CANCELADO
}

enum PerfilUsuario {
  CLIENTE
  ATENDENTE
  ADMINISTRADOR
}

model Servico {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  preco     Decimal
  duracao   Int
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profissionais ProfissionalServico[]
  agendamentos  Agendamento[]
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets    Pet[]
  usuario Usuario?
}

model Pet {
  id             Int       @id @default(autoincrement())
  nome           String
  especie        String
  raca           String?
  dataNascimento DateTime?
  observacoes    String?
  ativo          Boolean   @default(true)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agendamentos Agendamento[]
}

model Profissional {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicos     ProfissionalServico[]
  agendamentos Agendamento[]
}

model ProfissionalServico {
  profissionalId Int
  servicoId      Int

  profissional Profissional @relation(fields: [profissionalId], references: [id])
  servico      Servico      @relation(fields: [servicoId], references: [id])

  @@id([profissionalId, servicoId])
}

model Agendamento {
  id          Int               @id @default(autoincrement())
  dataHora    DateTime
  status      StatusAgendamento @default(AGENDADO)
  observacoes String?

  petId          Int
  servicoId      Int
  profissionalId Int

  pet          Pet          @relation(fields: [petId], references: [id])
  servico      Servico      @relation(fields: [servicoId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id       Int           @id @default(autoincrement())
  googleId String        @unique
  nome     String
  email    String        @unique
  perfil   PerfilUsuario @default(CLIENTE)
  ativo    Boolean       @default(true)

  clienteId Int?     @unique
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}